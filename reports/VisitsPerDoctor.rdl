  <DataSets>
    <DataSet Name="VisitsPerDoctor">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="FromDateParam">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>FromDateParam</Value>
          </QueryParameter>
          <QueryParameter Name="ToDateParam">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>ToDateParam</Value>
          </QueryParameter>
          <QueryParameter Name="DepartmentId">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>DepartmentId</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @FromDate DATE = @FromDateParam;
DECLARE @ToDate   DATE = @ToDateParam;

SELECT
    s.Id        AS DoctorId,
    s.FullName  AS DoctorName,
    d.Name      AS DepartmentName,
    COUNT(v.Id) AS VisitCount
FROM Visits v
JOIN StaffMembers s  ON s.Id = v.DoctorId
LEFT JOIN Departments d ON d.Id = s.DepartmentId
WHERE v.IsDeleted = 0
  AND v.VisitDate &gt;= @FromDate
  AND v.VisitDate &lt; DATEADD(DAY, 1, @ToDate)
  AND (@DepartmentIdParam IS NULL OR d.Id = @DepartmentIdParam)
GROUP BY s.Id, s.FullName, d.Name
ORDER BY d.Name, s.FullName;</CommandText>
      </Query>
      <Fields>
        <Field Name="DoctorName">
          <rd:UserDefined>true</rd:UserDefined>
          <DataField>DoctorName</DataField>
        </Field>
        <Field Name="DepartmentName">
          <rd:UserDefined>true</rd:UserDefined>
          <DataField>DepartmentName</DataField>
        </Field>
        <Field Name="VisitCount">
          <rd:UserDefined>true</rd:UserDefined>
          <DataField>VisitCount</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DepartmentsLookup">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT Id, Name
FROM Departments
ORDER BY Name;</CommandText>
      </Query>
    </DataSet>
  </DataSets>
